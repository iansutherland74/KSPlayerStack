--- a/haicrypt/cryspr-gnutls.c
+++ b/haicrypt/cryspr-gnutls.c
@@ -35,6 +35,92 @@ typedef struct tag_crysprGnuTLS_AES_cb {
 } crysprGnuTLS_cb;
 
 
+static nettle_cipher_func *crysprGnuTLS_AES_EncryptFunc(CRYSPR_AESCTX *aes_key)
+{
+    switch (aes_key->key_size) {
+    case AES128_KEY_SIZE:
+        return (nettle_cipher_func *)aes128_encrypt;
+    case AES192_KEY_SIZE:
+        return (nettle_cipher_func *)aes192_encrypt;
+    case AES256_KEY_SIZE:
+        return (nettle_cipher_func *)aes256_encrypt;
+    default:
+        return NULL;
+    }
+}
+
+static void *crysprGnuTLS_AES_Context(CRYSPR_AESCTX *aes_key)
+{
+    switch (aes_key->key_size) {
+    case AES128_KEY_SIZE:
+        return &aes_key->ctx.aes128;
+    case AES192_KEY_SIZE:
+        return &aes_key->ctx.aes192;
+    case AES256_KEY_SIZE:
+        return &aes_key->ctx.aes256;
+    default:
+        return NULL;
+    }
+}
+
+static int crysprGnuTLS_AES_Encrypt(
+    CRYSPR_AESCTX *aes_key,
+    size_t length,
+    uint8_t *dst,
+    const uint8_t *src)
+{
+    switch (aes_key->key_size) {
+    case AES128_KEY_SIZE:
+        aes128_encrypt(&aes_key->ctx.aes128, length, dst, src);
+        return 0;
+    case AES192_KEY_SIZE:
+        aes192_encrypt(&aes_key->ctx.aes192, length, dst, src);
+        return 0;
+    case AES256_KEY_SIZE:
+        aes256_encrypt(&aes_key->ctx.aes256, length, dst, src);
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+static int crysprGnuTLS_AES_Decrypt(
+    CRYSPR_AESCTX *aes_key,
+    size_t length,
+    uint8_t *dst,
+    const uint8_t *src)
+{
+    switch (aes_key->key_size) {
+    case AES128_KEY_SIZE:
+        aes128_decrypt(&aes_key->ctx.aes128, length, dst, src);
+        return 0;
+    case AES192_KEY_SIZE:
+        aes192_decrypt(&aes_key->ctx.aes192, length, dst, src);
+        return 0;
+    case AES256_KEY_SIZE:
+        aes256_decrypt(&aes_key->ctx.aes256, length, dst, src);
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+static int crysprGnuTLS_AES_CtrCrypt(
+    CRYSPR_AESCTX *aes_key,
+    unsigned char *iv,
+    size_t length,
+    uint8_t *dst,
+    const uint8_t *src)
+{
+    void *ctx = crysprGnuTLS_AES_Context(aes_key);
+    nettle_cipher_func *encrypt = crysprGnuTLS_AES_EncryptFunc(aes_key);
+    if (ctx == NULL || encrypt == NULL) {
+        return -1;
+    }
+    ctr_crypt(ctx, encrypt, CRYSPR_AESBLKSZ, iv, length, dst, src);
+    return 0;
+}
